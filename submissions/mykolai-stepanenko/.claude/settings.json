{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(composer require *)",
      "Bash(composer install *)",
      "Bash(composer update *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run-node.sh", "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-env.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run-node.sh", "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-actions.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run-node.sh", "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-actions.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run-node.sh", "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-actions.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["context7"]
}
